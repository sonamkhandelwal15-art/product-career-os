# Copy to .env for local use. On a host (Render, Railway), set these in its
# environment settings instead — never commit a real .env.

# Required for AI reviews
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# Only for org-scoped keys; `npm run doctor` tells you if you need it
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Required when deployed. Locks every page and API route behind a login.
# The server refuses to start in production without it.
# APP_PASSWORD=choose-a-long-passphrase
# APP_USER=sonam

PORT=3311
# DATA_DIR=/data          # set on hosts to point at a persistent disk
# NODE_ENV=production     # hosts usually set this for you
